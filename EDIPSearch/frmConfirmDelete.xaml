<Window x:Class="EDIPSearch.frmConfirmDelete"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EDIPSearch"
        mc:Ignorable="d"
         Title="Бортовой компьютер: Подтверждение удаления" Height="220" Width="450"
        Background="#11161B" Foreground="#E0E6ED"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EliteTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#11161B" BorderBrush="#FF7100" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <!-- Шапка -->
                <RowDefinition Height="*"/>
                <!-- Текст сообщения -->
                <RowDefinition Height="Auto"/>
                <!-- Кнопки -->
            </Grid.RowDefinitions>

            <!-- Кастомный заголовок окна -->
            <Grid Grid.Row="0" Background="#252F38" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="КРИТИЧЕСКОЕ ДЕЙСТВИЕ: УДАЛЕНИЕ АДРЕСОВ" 
                           Foreground="#FF7100" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="11"/>
            </Grid>

            <!-- Зона сообщения -->
            <Grid Grid.Row="1" Margin="20,15,20,10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Вы действительно хотите удалить следующие объекты из базы и файрвола роутеров?" 
                               Foreground="#88E0E6ED" TextWrapping="Wrap" Margin="0,0,0,10" FontSize="11"/>

                    <!-- Сюда динамически подставим список адресов или их количество -->
                    <TextBlock x:Name="txtMessage" 
                               Foreground="#FFA000" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Нижняя панель с кнопками -->
            <Border Grid.Row="2" BorderBrush="#33FF7100" BorderThickness="0,1,0,0" Padding="15,10" Background="#1B2228">
                <Grid>
                    <Button x:Name="btnCancel" Content="ОТМЕНА" HorizontalAlignment="Left" Width="100" Height="26" Style="{StaticResource EliteButton}" Click="BtnCancel_Click"/>
                    <Button x:Name="btnConfirm" Content="ПОДТВЕРДИТЬ" HorizontalAlignment="Right" Width="120" Height="26" Style="{StaticResource EliteButton}" Click="BtnConfirm_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>