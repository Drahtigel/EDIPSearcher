<Window x:Class="EDIPSearch.frmSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EDIPSearch"
        mc:Ignorable="d"
             Title="Бортовой компьютер: Настройки конфигурации" Height="450" Width="800" 
        Background="#11161B" Foreground="#E0E6ED"
        Icon="pack://application:,,,/app_icon.ico"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EliteTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#11161B" BorderBrush="#FF7100" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <!-- Роу 0: Заголовок -->
                <RowDefinition Height="*"/>
                <!-- Роу 1: Контент вкладок -->
            </Grid.RowDefinitions>

            <!-- ФИРМЕННЫЙ ЗАГОЛОВОК ОКНА -->
            <Grid Grid.Row="0" Background="#252F38" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="БОРТОВОЙ КОМПЬЮТЕР: НАСТРОЙКИ КОНФИГУРАЦИИ" 
                           Foreground="#FF7100" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="11"/>
                <Button Content="r" FontFamily="Marlett" Width="35" Height="30" Grid.Column="1" Click="BtnClose_Click" Style="{StaticResource EliteButton}" BorderThickness="0" Background="Transparent"/>
            </Grid>

            <!-- ОСНОВНОЙ КОНТЕНТ -->
            <DockPanel Grid.Row="1" Margin="10">
                <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#33FF7100" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
                    <Grid>
                        <Button x:Name="btnCancel" Style="{StaticResource EliteButton}" Content="ОТМЕНА" HorizontalAlignment="Left" Width="100" Height="28"/>
                        <Button x:Name="btnOK" Style="{StaticResource EliteButton}" Content="СОХРАНИТЬ" HorizontalAlignment="Right" Width="100" Height="28"/>
                    </Grid>
                </Border>

                <!-- ВКЛАДКИ НАСТРОЕК -->
                <TabControl>
                    <TabItem Header="Основные настройки">
                        <Grid Margin="15">
                            <StackPanel>
                                <!-- Настройка 1: Авто-отслеживание -->
                                <CheckBox x:Name="cbListenLog" 
                                          Content="Отслеживать активный лог-файл сетевых соединений в реальном времени" 
                                          Margin="0,0,0,20"/>

                                <!-- НАША НОВАЯ НАСТРОЙКА: Удаление файлов -->
                                <CheckBox x:Name="cbDeleteProcessedLogs" 
                                          Content="Принудительно удалять файлы логов после завершения анализа истории" 
                                          Foreground="#FFA000"
                                          ToolTip="Автоматически стирает старые обработанные файлы netLog, исключая файлы с текущей датой."
                                          Margin="0,0,0,10"/>

                                <TextBlock Text="* Внимание: Система безопасности оставляет нетронутыми логи за сегодняшние сутки, чтобы не прерывать запись активной сессии." 
                                           Foreground="#55E0E6ED" FontSize="10" TextWrapping="Wrap" Margin="20,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- ВКЛАДКА 2: ФИЛЬТРЫ -->
                    <TabItem Header="Фильтры" ToolTip="Пул исключений IP-адресов">
                <DockPanel Margin="5">
                    <!-- Тулбар для добавления -->
                    <ToolBar DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Label Content="Добавить IP/Подсеть:" VerticalAlignment="Center" Foreground="#FF7100" Margin="0,0,5,0"/>
                        <TextBox x:Name="tbAddress" Width="180" Height="24" VerticalContentAlignment="Center"/>

                        <!-- Плюс и Минус теперь ровные центрированные кнопки -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="btnFilterAdd" Content="ДОБАВИТЬ" Width="100" Height="26" Margin="0,0,10,0" Style="{StaticResource EliteButton}" Click="BtnFilterAdd_Click"/>
                                    <Button x:Name="btnFilterRemove" Content="УДАЛИТЬ" Width="100" Height="26" Style="{StaticResource EliteButton}" Click="BtnFilterRemove_Click"/>
                                </WrapPanel>
                            </ToolBar>

                    <!-- ТАБЛИЦА ФИЛЬТРОВ: Отредерена через GridView колонок -->
                    <ListView x:Name="lvFilters" Background="Transparent" BorderThickness="0" Foreground="#E0E6ED">
                        <!-- Умный стиль строк (остается без изменений, твоя раскраска комментариев) -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                        <Setter Property="Foreground" Value="#55FF7100"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#1B2228"/>
                                        <Setter Property="Foreground" Value="#FF7100"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#FF7100"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                        Padding="{TemplateBinding Padding}">
                                                        <!-- ИСПРАВЛЕНО: Центрируем заголовки для Маски и Размера, если это указано в колонке -->
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#25FF7100"/>
                                                            <Setter Property="Foreground" Value="#FFA000"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>

                                <!-- Колонки таблицы -->
                                <!-- 1. IP адрес (выравнивание по левому краю) -->
                                <GridViewColumn Header="IP АДРЕС / ДИАПАЗОН ИСКЛЮЧЕНИЯ" DisplayMemberBinding="{Binding IP}" Width="430"/>

                                <!-- 2. Маска (убрали ошибочный параметр) -->
                                <GridViewColumn Header="МАСКА" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mask}" TextAlignment="Center" Width="130" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 3. Размер пула (убрали ошибочный параметр) -->
                                <GridViewColumn Header="РАЗМЕР ПУЛА" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size}" TextAlignment="Center" Width="130" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ВКЛАДКА 3: ИНТЕГРАЦИЯ -->
            <TabItem Header="Интеграция" ToolTip="Связь с маршрутизатором">
                <Grid Margin="15">
                    <TextBlock Text="Настройки интеграции REST API управляются через отдельный модуль на главном экране." 
                               Foreground="#88E0E6ED" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
            </DockPanel>
        </Grid>
    </Border>
</Window>
