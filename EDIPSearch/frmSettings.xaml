<Window x:Class="EDIPSearch.frmSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EDIPSearch"
        mc:Ignorable="d"
        Title="Бортовой компьютер: Настройки конфигурации" Height="450" Width="800" Background="#11161B" Foreground="#E0E6ED"
        Icon="pack://application:,,,/app_icon.ico">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EliteTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- НИЖНЯЯ ПАНЕЛЬ С КНОПКАМИ: Развели по краям и отделили оранжевой линией -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#33FF7100" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0">
            <Grid>
                <Button x:Name="btnCancel" Style="{StaticResource EliteButton}" Content="ОТМЕНА" HorizontalAlignment="Left" Width="100" Height="28"/>
                <Button x:Name="btnOK" Style="{StaticResource EliteButton}" Content="СОХРАНИТЬ" HorizontalAlignment="Right" Width="100" Height="28"/>
            </Grid>
        </Border>

        <!-- ОСНОВНОЙ БЛОК ВКЛАДОК -->
        <TabControl>
            <TabItem Header="Основные настройки">
                <!-- Padding="10" на самом гриде создаст одинаковые идеальные отступы от краев вкладки со всех сторон -->
                <Grid  Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Строка 1: Путь к ED -->
                        <RowDefinition Height="Auto"/>
                        <!-- Строка 2: Хранилище -->
                        <RowDefinition Height="Auto"/>
                        <!-- Строка 3: Чекбокс отслеживания -->
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <!-- Фиксированная ширина для подписей, чтобы левый край полей ввода был идеально ровным -->
                        <ColumnDefinition Width="230"/>
                        <!-- Поля ввода (*) заберут абсолютно всё свободное место между текстом и кнопкой -->
                        <ColumnDefinition Width="*"/>
                        <!-- Кнопка-иконка четко зафиксирована на правом краю -->
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- СТРОКА 1: ПУТЬ К ELITE DANGEROUS -->
                    <Label Content="Путь к каталогу Elite Dangerous:" 
               Grid.Row="0" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,8"/>

                    <TextBox x:Name="tbEdPath" 
                 Grid.Row="0" Grid.Column="1" 
                 Height="26" Margin="5,8,10,8" 
                 VerticalContentAlignment="Center"/>

                    <Button x:Name="btnEDOpen" 
                Grid.Row="0" Grid.Column="2" 
                Style="{StaticResource EliteButton}" Content="📁" 
                Width="32" Height="26" Margin="0,8" Padding="0" FontSize="14" 
                ToolTip="Выбрать каталог игры"/>

                    <!-- СТРОКА 2: ХРАНИЛИЩЕ ДАННЫХ ПРИЛОЖЕНИЯ -->
                    <Label Content="Хранилище данных приложения:" 
               Grid.Row="1" Grid.Column="0" 
               VerticalAlignment="Center" Margin="0,8"/>

                    <!-- Теперь это поле имеет точно такую же длину и выравнивание, как верхнее -->
                    <TextBox x:Name="tbWorkingDir" 
                 Grid.Row="1" Grid.Column="1" 
                 Height="26" Margin="5,8,10,8" 
                 VerticalContentAlignment="Center"/>

                    <!-- Кнопка встала строго под верхней, образуя ровную линию правого края -->
                    <Button x:Name="btnWorkingDir" 
                Grid.Row="1" Grid.Column="2" 
                Style="{StaticResource EliteButton}" Content="📁" 
                Width="32" Height="26" Margin="0,8" Padding="0" FontSize="14" 
                ToolTip="Выбрать папку хранилища"/>

                    <!-- СТРОКА 3: ЧЕКБОКС АВТО-ОТСЛЕЖИВАНИЯ -->
                    <!-- Размещаем его во 2-й колонке (под началом текстовых полей), растягивая на 2 колонки вправо -->
                    <CheckBox x:Name="cbListenLog" 
                  Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" 
                  Content="Отслеживать активный лог-файл в реальном времени" 
                  Margin="5,15,0,0"/>
                </Grid>
            </TabItem>



            <!-- ВКЛАДКА 2: ФИЛЬТРЫ АДРЕСОВ (ListView превращен в таблицу) -->
            <TabItem Header="Фильтры" ToolTip="Пул исключений IP-адресов">
                <DockPanel Margin="5">
                    <!-- Тулбар для добавления -->
                    <ToolBar DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Label Content="Добавить IP/Подсеть:" VerticalAlignment="Center" Foreground="#FF7100" Margin="0,0,5,0"/>
                        <TextBox x:Name="tbAddress" Width="180" Height="24" VerticalContentAlignment="Center"/>

                        <!-- Плюс и Минус теперь ровные центрированные кнопки -->
                        <Button Style="{StaticResource EliteButton}" x:Name="tbFilterAdd" Width="26" Height="24" Margin="6,0,0,0" Padding="0" FontWeight="Bold" Content="+"/>
                        <Button Style="{StaticResource EliteButton}" x:Name="tbFilterRemove" Width="26" Height="24" Margin="4,0,0,0" Padding="0" FontWeight="Bold" Content="-"/>
                    </ToolBar>

                    <!-- ТАБЛИЦА ФИЛЬТРОВ: Отредерена через GridView колонок -->
                    <ListView x:Name="lvFilters" Background="Transparent" BorderThickness="0" Foreground="#E0E6ED">
                        <!-- Умный стиль строк (остается без изменений, твоя раскраска комментариев) -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComment}" Value="True">
                                        <Setter Property="Foreground" Value="#55FF7100"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                        <Setter Property="Focusable" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#1B2228"/>
                                        <Setter Property="Foreground" Value="#FF7100"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#FF7100"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                        Padding="{TemplateBinding Padding}">
                                                        <!-- ИСПРАВЛЕНО: Центрируем заголовки для Маски и Размера, если это указано в колонке -->
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="#25FF7100"/>
                                                            <Setter Property="Foreground" Value="#FFA000"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>

                                <!-- Колонки таблицы -->
                                <!-- 1. IP адрес (выравнивание по левому краю) -->
                                <GridViewColumn Header="IP АДРЕС / ДИАПАЗОН ИСКЛЮЧЕНИЯ" DisplayMemberBinding="{Binding IP}" Width="430"/>

                                <!-- 2. Маска (убрали ошибочный параметр) -->
                                <GridViewColumn Header="МАСКА" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Mask}" TextAlignment="Center" Width="130" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <!-- 3. Размер пула (убрали ошибочный параметр) -->
                                <GridViewColumn Header="РАЗМЕР ПУЛА" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Size}" TextAlignment="Center" Width="130" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=Foreground}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

            <!-- ВКЛАДКА 3: ИНТЕГРАЦИЯ -->
            <TabItem Header="Интеграция" ToolTip="Связь с маршрутизатором">
                <Grid Margin="15">
                    <TextBlock Text="Настройки интеграции REST API управляются через отдельный модуль на главном экране." 
                               Foreground="#88E0E6ED" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
