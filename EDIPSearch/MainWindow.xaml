<Window x:Class="EDIPSearch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EDIPSearch"
        mc:Ignorable="d"
        Title="Elite Dangerous: Log Parser &amp; Router Sync [CMDR Edition]" Height="450" Width="800"  Background="#11161B" Foreground="#E0E6ED"
        Icon="pack://application:,,,/app_icon.ico"
        WindowStyle="None"
        AllowsTransparency="True"
       >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="EliteTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="#11161B" BorderBrush="#FF7100" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <!-- Роу 0: Яркая шапка -->
                <RowDefinition Height="Auto"/>
                <!-- Роу 1: Кнопки управления -->
                <RowDefinition Height="*"/>
                <!-- Роу 2: Основной контент таблицы -->
            </Grid.RowDefinitions>

            <!-- ========================================== -->
            <!-- СТРОКА 0: КАСТОМНЫЙ ЗАГОЛОВОК ОКНА (ЯРКИЙ ФОН) -->
            <!-- ========================================== -->
            <Grid Grid.Row="0" Background="#252F38" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Elite Dangerous: Log Parser &amp; Router Sync [CMDR Edition]" 
                           Foreground="#FF7100" FontWeight="Bold" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="11"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="0" FontFamily="Marlett" Width="35" Height="30" Click="BtnMinimize_Click" Style="{StaticResource EliteButton}" BorderThickness="0" Background="Transparent"/>
                    <Button Content="r" FontFamily="Marlett" Width="35" Height="30" Click="BtnClose_Click" Style="{StaticResource EliteButton}" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </Grid>
            <!-- ========================================== -->
            <!-- СТРОКА 1: ПАНЕЛЬ УПРАВЛЕНИЯ С КНОПКАМИ -->
            <!-- ========================================== -->
            <Border Grid.Row="1" Background="#1B2228" CornerRadius="4" Padding="10" Margin="15,15,15,0" BorderBrush="#33FF7100" BorderThickness="1">
                <Grid>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnOldParse" Content="АНАЛИЗ ЛОГОВ" Margin="0,0,10,0" Click="BtnOldParse_Click" Style="{StaticResource EliteButton}"/>
                        <Button Content="НАСТРОЙКИ" Margin="0,0,20,0" Click="BtnOldSettings_Click" Style="{StaticResource EliteButton}" />
                        <Button Content=" MIKROTIK REST" Style="{StaticResource EliteButton}" Margin="0,0,20,0" Click="BtnOpenSettings_Click"/>

                        <!-- КНОПКА: Включение сетевого лога Elite Dangerous -->
                        <Button x:Name="btnEnableNetLog" Content="ВКЛЮЧИТЬ СЕТЕВОЙ ЛОГ" Margin="0,0,20,0" Click="BtnEnableNetLog_Click" Style="{StaticResource EliteButton}"/>

                        <CheckBox x:Name="chkEnableMonitoring" Content="АВТО-ОТСЛЕЖИВАНИЕ" Foreground="#FF7100" FontWeight="Bold" Margin="0,0,20,0" VerticalAlignment="Center" Checked="ChkEnableMonitoring_Checked" Unchecked="ChkEnableMonitoring_Unchecked" IsChecked="True"/>

                        <!-- Статус игры -->
                        <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                            <TextBlock x:Name="txtGameIcon" Text="" FontSize="16" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="txtGameStatus" Text="ИГРА НЕ ЗАПУЩЕНА" Foreground="#FF4500" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ========================================== -->
            <!-- СТРОКА 2: НАЧАЛО ОСНОВНОГО КОНТЕНТА -->
            <!-- ========================================== -->
            <Grid Grid.Row="2" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <!-- ЛЕВАЯ ЧАСТЬ: Сводная таблица адресов dgAddresses -->
                    <Border Grid.Column="0" Background="#1B2228" CornerRadius="4" BorderBrush="#22FF7100" BorderThickness="1" Margin="0,0,10,0" Padding="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Text="ВСЕГО АДРЕСОВ В ТАБЛИЦЕ: " Foreground="#E0E6ED" FontWeight="Bold"/>
                                <TextBlock x:Name="txtTotalAddressesCount" Text="0" Foreground="#FFA000" FontWeight="Bold"/>
                            </StackPanel>

                            <DataGrid x:Name="dgAddresses" Grid.Row="1" Background="Transparent" RowBackground="#161C20" AlternatingRowBackground="#1B2228" Foreground="#E0E6ED" BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A33FF71" AutoGenerateColumns="False" CanUserAddRows="False" SelectionUnit="FullRow" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Resources>
                                    <Style TargetType="CheckBox">
                                        <Setter Property="Background" Value="#11161B"/>
                                        <Setter Property="BorderBrush" Value="#FF7100"/>
                                        <Setter Property="Foreground" Value="#E0E6ED"/>
                                    </Style>
                                    <Style x:Key="ScrollThumbs" TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Grid x:Name="Grid">
                                                        <Border Background="#55FF7100" CornerRadius="3" MinHeight="20"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="true">
                                                            <Setter Property="Background" Value="#FF7100"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Background" Value="#11161B"/>
                                        <Setter Property="Width" Value="8"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="#11161B">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="true">
                                                            <Track.DecreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                                                            </Track.DecreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb Style="{StaticResource ScrollThumbs}"/>
                                                            </Track.Thumb>
                                                            <Track.IncreaseRepeatButton>
                                                                <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                                                            </Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.ContextMenu>
                                    <ContextMenu Background="#1B2228" BorderBrush="#FF7100" BorderThickness="1">
                                        <MenuItem Header="Выгрузить список в TXT..." Click="BtnExportText_Click"/>
                                        <!-- Сепаратор-разделитель -->
                                        <Separator Background="#33FF7100" Margin="2,4"/>
                                        <MenuItem Header="Добавить новый IP/Подсеть..." Click="BtnOpenOverlay_Click"/>
                                        <!-- НАШ НОВЫЙ ПУНКТ: Удаление адреса из таблицы и роутеров -->
                                        <MenuItem Header="Удалить выбранный адрес" Click="BtnDeleteAddress_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1B2228"/>
                                        <Setter Property="Foreground" Value="#FF7100"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="BorderBrush" Value="#FF7100"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="IP АДРЕС" Binding="{Binding IP}" Width="2*"/>
                                    <DataGridTextColumn Header="МАСКА" Binding="{Binding Mask}" Width="1*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- ПРАВАЯ ЧАСТЬ: Мониторинг журнала -->
                    <Border Grid.Column="1" Background="#1B2228" CornerRadius="4" BorderBrush="#33FF7100" BorderThickness="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="МОНИТОРИНГ ЖУРНАЛА:" Foreground="#FF7100" FontWeight="Bold" Margin="0,0,0,8"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Файл: " Foreground="#888" FontSize="11"/>
                                <TextBlock x:Name="txtCurrentLogFile" Text="нет файла" Foreground="#E0E6ED" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Прочитано строк: " Foreground="#888" FontSize="11"/>
                                <TextBlock x:Name="txtTotalLinesRead" Text="0" Foreground="#FFA000" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                            <ListBox x:Name="lstLiveActivity" Grid.Row="3" Background="#11161B" Foreground="#FFA000" BorderThickness="0" FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="2"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- НИЖНИЙ СТАТУС-БАР -->
                <StatusBar Grid.Row="1" Background="Transparent" Foreground="#888" Margin="0,10,0,0" Padding="0">
                    <StatusBarItem Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="tbStatusProp" Text="Ожидание..." Foreground="#FFA000"/>
                            <TextBlock Text=" | " Foreground="#333"/>
                            <TextBlock x:Name="tbStatusVal" Text="" Foreground="#E0E6ED"/>
                        </StackPanel>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
            <!-- ========================================== -->
            <!-- ОВЕРЛЕЙ ДЛЯ РУЧНОГО ДОБАВЛЕНИЯ АДРЕСА     -->
            <!-- ========================================== -->
            <!-- По умолчанию видимость скрыта (Collapsed). Кнопка "ДОБАВИТЬ" включит её -->
            <Grid x:Name="gridOverlay" Grid.Row="0" Grid.RowSpan="3" Background="#AA000000" Visibility="Collapsed">
                <Border BorderBrush="#FF7100" BorderThickness="1" Background="#11161B" 
                        CornerRadius="4" Width="400" Height="180" 
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Заголовок -->
                            <RowDefinition Height="*"/>
                            <!-- Поле ввода -->
                            <RowDefinition Height="Auto"/>
                            <!-- Кнопки -->
                        </Grid.RowDefinitions>

                        <!-- Заголовок оверлея -->
                        <TextBlock Grid.Row="0" Text="КОМАНДНЫЙ ИНТЕРФЕЙС: ДОБАВЛЕНИЕ IP / ПОДСЕТИ" 
                                   Foreground="#FF7100" FontWeight="Bold" FontSize="11" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                        <!-- Поле ввода с подсказкой внутри Grid -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <TextBox x:Name="tbInputAddress" Height="26" VerticalContentAlignment="Center" Padding="5,0"
                                     ToolTip="Введите IP (например, 1.2.3.4) или подсеть (1.2.3.0/24)"/>
                            <TextBlock x:Name="lblValidationError" Text="Неверный формат IP-адреса или подсети!" 
                                       Foreground="#FF4500" FontSize="10" FontWeight="Bold" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Кнопки управления внизу оверлея -->
                        <Grid Grid.Row="2" Margin="0,15,0,0">
                            <Button x:Name="btnOverlayCancel" Content="ОТМЕНА" HorizontalAlignment="Left" Width="90" Height="26" Style="{StaticResource EliteButton}" Click="BtnOverlayCancel_Click"/>
                            <Button x:Name="btnOverlaySubmit" Content="ВНЕСTI В БАЗУ" HorizontalAlignment="Right" Width="120" Height="26" Style="{StaticResource EliteButton}" Click="BtnOverlaySubmit_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
